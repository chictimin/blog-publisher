# blog-publisher 설정 템플릿. 이 파일은 값이 비어 있어 저장소에 커밋된다.
# 복사해서 .env 로 쓰고 값을 채운다. .env 는 .gitignore 되어 커밋되지 않는다.
#
# ★ 비밀값(API 키·PAT)은 프로젝트 밖 ~/.config/blog-publisher/env 에 둔다.
#   npm run eval 이 그 파일과 .env 를 함께 읽는다.
#
# ─────────────────────────────────────────────────────────────
# 1) 평가 스크립트용 (node scripts/eval.mjs)  ← 안전
# ─────────────────────────────────────────────────────────────
# Node 프로세스만 읽는다. 웹 번들에 들어가지 않는다.

# OPENAI_API_KEY 는 ~/.config/blog-publisher/env 에 넣는다 (이 파일에 넣지 않는다)
# OPENAI_BASE_URL 도 같은 파일에 넣는다
# GITHUB_TOKEN 도 같은 파일에 넣는다

# 평가 대상 저장소 (--owner/--repo 인자 대신 쓸 수 있다)
EVAL_OWNER=
EVAL_REPO=

# 비교할 모델 2종. 쉼표로 구분. 값을 모르면 아래로 목록을 먼저 조회한다.
#   npm run eval -- --list-models
EVAL_MODELS=


# ─────────────────────────────────────────────────────────────
# 2) 로컬 개발 편의용 (npm run dev)  ← 주의해서 쓸 것
# ─────────────────────────────────────────────────────────────
# VITE_ 접두사 변수는 Vite 가 빌드 산출물에 그대로 인라인한다.
# 즉 이 값을 채운 뒤 로컬에서 npm run build 한 dist 를 어딘가에 올리면
# 키가 공개된다. 배포는 GitHub Actions 가 하고 러너에는 이 파일이 없으므로
# 정상 배포 경로에서는 노출되지 않지만, 로컬 빌드 산출물은 직접 배포하지 말 것.
#
# 개발 서버에서 폼을 매번 채우는 수고만 줄이는 용도다. 비워 두어도 앱은 동작한다.

VITE_DEV_API_KEY=
VITE_DEV_BASE_URL=
VITE_DEV_GITHUB_TOKEN=
VITE_DEV_REPO=
